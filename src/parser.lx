@module "parse"

@use "std_cstring" as string
@use "utility" as util
@use "std_io" as io

const USE_DIRECTIVE_LEN: i64 = 4;
const MAX_DEPS: i64 = 200;

#returns_ownership
pub const parse_file_line -> fn (file_list: *byte, start: i64, end: i64) *byte {
    let line_len: i64 = end - start;
    if (line_len <= 0) return cast<*byte>(0);

    // Strip trailing CR for Windows CRLF line endings
    let len: i64 = line_len;
    if (len > 0 && file_list[end - 1] == '\r') {
        len = len - 1;
    }

    return util::clean_dotslash_prefix(util::copy_string(file_list, start, len));
}

const skip_whitespace -> fn (content: *byte, pos: i64, max_len: i64) i64 {
    loop (pos < max_len && (content[pos] == ' ' || content[pos] == '\t')) : (pos = pos + 1) {}
    return pos;
}

const is_at_line_start -> fn (content: *byte, pos: i64) i64 {
    if (pos == 0) return 1;

    let check_pos: i64 = pos - 1;
    loop (check_pos >= 0) {
        if (content[check_pos] == '\n') return 1;
        if (content[check_pos] != ' ' && content[check_pos] != '\t') return 0;
        check_pos = check_pos - 1;
    }
    return 1;
}

#returns_ownership
pub const find_imports -> fn (file_path: *byte, out_count: *i64) **byte {
    let imports: **byte = cast<**byte>(alloc(MAX_DEPS * sizeof<*byte>));
    *out_count = 0;

    let content: *byte = io::read_file(file_path);
    if (content == cast<*byte>(0)) return imports;

    defer { free(content); }

    let len: i64 = string::strlen(content);
    let i: i64 = 0;

    loop (i < len) {
        if (i + 1 < len && content[i] == '/' && content[i + 1] == '/') {
            loop (i < len && content[i] != '\n') : (i = i + 1) {}
            continue;
        }

        if (i + USE_DIRECTIVE_LEN <= len && content[i] == '@') {
            if (is_at_line_start(content, i) == 0) {
                i = i + 1;
                continue;
            }

            let matches: i64 = 1;
            let use_str: *byte = "@use";

            loop [j: i64 = 0](j < USE_DIRECTIVE_LEN) : (j = j + 1) {
                if (content[i + j] != use_str[j]) {
                    matches = 0;
                    break;
                }
            }

            if (matches == 1) {
                i = i + USE_DIRECTIVE_LEN;
                i = skip_whitespace(content, i, len);

                if (i < len && content[i] == '"') {
                    i = i + 1;
                    let mod_start: i64 = i;

                    loop (i < len && content[i] != '"') : (i = i + 1) {}

                    let mod_len: i64 = i - mod_start;
                    if (mod_len > 0 && *out_count < MAX_DEPS) {
                        imports[*out_count] = util::copy_string(content, mod_start, mod_len);
                        *out_count = *out_count + 1;
                    }
                }
                continue;
            }
        }

        i = i + 1;
    }

    return imports;
}
