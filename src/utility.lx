@module "utility"

@use "std_cstring" as string
@use "std_memory" as mem
@use "std_io" as io

pub const file_exists -> fn (filepath: *byte) i64 {
    let content: *byte = io::read_file(filepath);
    defer { free(content); }

    if (content != cast<*byte>(0)) return 1;
    return 0;
}

pub const strip_trailing_newline -> fn (s: *byte) void {
    let len: i64 = string::strlen(s);
    if (len > 0 && s[len-1] == '\n') {
        s[len-1] = '\0';
    }
}

pub const has_extension -> fn (filepath: *byte, ext: *byte) i64 {
    let len: i64 = string::strlen(filepath);
    let ext_len: i64 = string::strlen(ext);

    if (len < ext_len) return 0;

    loop [i: i64 = 0](i < ext_len) : (i = i + 1) {
        if (filepath[len - ext_len + i] != ext[i]) return 0;
    }
    return 1;
}

#returns_ownership
pub const clean_dotslash_prefix -> fn (filepath: *byte) *byte {
    let len: i64 = string::strlen(filepath);

    if (len >= 2 && filepath[0] == '.' && filepath[1] == '/') {
        let clean_path: *byte = cast<*byte>(alloc((len - 1) * sizeof<byte>));
        mem::memcpy(cast<*void>(clean_path), cast<*void>(&filepath[2]), len - 2);
        clean_path[len - 2] = '\0';
        free(filepath);
        return clean_path;
    }

    return filepath;
}

#returns_ownership
pub const copy_string -> fn (src: *byte, start: i64, len: i64) *byte {
    let dest: *byte = cast<*byte>(alloc((len + 1) * sizeof<byte>));
    mem::memcpy(cast<*void>(dest), cast<*void>(&src[start]), len);
    dest[len] = '\0';
    return dest;
}

pub const contains_main_function -> fn (filepath: *byte) i64 {
    let content: *byte = io::read_file(filepath);
    if (content == cast<*byte>(0)) return 0;

    let len: i64 = string::strlen(content);
    let pattern: *byte = "pub const main -> fn";
    let pattern_len: i64 = string::strlen(pattern);
    let found: i64 = 0;

    let i: i64 = 0;
    loop (i < len - pattern_len) {
        let matches: i64 = 1;
        loop [j: i64 = 0](j < pattern_len) : (++j) {
            if (content[i + j] != pattern[j]) {
                matches = 0;
                break;
            }
        }

        if (matches == 1) {
            found = 1;
            break;
        }
        ++i;
    }

    free(content);
    return found;
}
